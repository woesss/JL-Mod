# Copy this file to keystore.properties and replace every placeholder.
# Use forward slashes in Windows paths to avoid escaping backslashes.
storeFile=X:/private/keystores/JL-Mod-Plus-UNIQUE-ID.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=jl-mod-plus-UNIQUE-ID
keyPassword=YOUR_KEY_PASSWORD
crashReportUrl=https://jl-mod-plus-crash-reporter.h3nb-jl-mod-plus.workers.dev/v1/crash-reports
crashReportToken=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
fingerprint=RELEASE_CERTIFICATE_SHA1_WITHOUT_COLONS
