# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# APK metadata file
output.json

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore
*.p12
keystore.properties
signing.properties
secrets.properties

# Local maintainer notes (not a substitute for encrypted secret storage)
docs/private/
docs/local/
*.private.md

# Environment files may contain local credentials
.env
.env.*
!.env.example
.dev.vars
server/crash-reporter/dist/
server/crash-reporter/node_modules/
server/crash-reporter/.wrangler/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

/.kotlin/

# JVM crash and profiling output
*.hprof
hs_err_pid*

# Operating-system metadata
.DS_Store
Thumbs.db
desktop.ini
